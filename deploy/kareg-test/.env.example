# Copy this file to .env for a persistent local deployment. The real .env is ignored.
SILO_IMAGE=ghcr.io/karnetk/silo:RELEASE.2026-07-31T00-17-54Z
SILO_ROOT_USER=replace-with-local-admin-name
SILO_ROOT_PASSWORD=replace-with-a-long-random-password
SILO_DATA_PATH=E:/SiloTest/data
SILO_API_PORT=19000
SILO_CONSOLE_PORT=19001
